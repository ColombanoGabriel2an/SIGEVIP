  <connectionStrings>
    <add
      name="SIGEVIP"
      providerName="System.Data.SqlClient"
      connectionString="Data Source=Lenovo_Gabi;Initial Catalog=SIGEVIP_TEST;Integrated Security=True;Connect Timeout=5;" />
  </connectionStrings>
</configuration>
